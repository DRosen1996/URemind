<view class="page">
  <view class="card status-card">
    <text class="label">今天状态</text>
    <text class="status {{hasStarted ? (isPillDay ? 'pill' : 'break') : 'pending'}}">{{phaseText}}</text>
    <text class="desc">{{statusDesc}}</text>
  </view>

  <view class="card">
    <view class="row">
      <text class="field-label">周期开始日</text>
      <picker mode="date" value="{{cycleStartDate}}" bindchange="onCycleDateChange">
        <text class="picker-value">{{cycleStartDate || '请选择日期'}}</text>
      </picker>
    </view>

    <view class="row">
      <text class="field-label">每日提醒时间</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onRemindTimeChange">
        <text class="picker-value">{{remindTime}}</text>
      </picker>
    </view>
  </view>

  <button
    class="main-btn {{reminderEnabled ? 'main-btn-disabled' : ''}}"
    bindtap="requestSubscribe"
    disabled="{{reminderEnabled}}"
  >
    {{reminderEnabled ? '提醒已开启' : '开启订阅提醒'}}
  </button>
  <button class="text-btn" bindtap="goSettings">更多设置</button>
  <text class="hint">{{reminderEnabled ? '提醒已开启（订阅消息）' : '提醒未开启，请先完成订阅授权'}}</text>
</view>
