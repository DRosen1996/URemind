<view class="page">

  <!-- 状态卡片 -->
  <view class="status-card {{hasStarted ? (isPillDay ? 'card-pill' : 'card-break') : 'card-pending'}}">
    <text class="status-eyebrow">今天状态</text>
    <text class="status-text">{{phaseText}}</text>
    <text class="status-desc">{{statusDesc}}</text>

    <!-- 28天进度点阵 -->
    <view class="dots-grid">
      <view class="dots-row">
        <view wx:for="{{cycleDots1}}" wx:key="i" class="dot dot-{{item.status}}"></view>
      </view>
      <view class="dots-row">
        <view wx:for="{{cycleDots2}}" wx:key="i" class="dot dot-{{item.status}}"></view>
      </view>
    </view>

    <text class="progress-label" wx:if="{{hasStarted}}">第 {{dayIndex}} / 28 天</text>
    <text class="progress-label" wx:else>周期未开始</text>
  </view>

  <!-- 配置卡片 -->
  <view class="card">
    <picker mode="date" value="{{cycleStartDate}}" bindchange="onCycleDateChange">
      <view class="config-row">
        <text class="config-label">周期开始日</text>
        <view class="config-value-wrap">
          <text class="config-value">{{cycleStartDate || '请选择日期'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>

    <view class="divider"></view>

    <picker mode="time" value="{{remindTime}}" bindchange="onRemindTimeChange">
      <view class="config-row">
        <text class="config-label">每日提醒时间</text>
        <view class="config-value-wrap">
          <text class="config-value {{remindTimePending ? 'config-value-pending' : ''}}">{{remindTime}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 订阅按钮 -->
  <button
    class="main-btn {{remindTimePending ? 'main-btn-pending' : (subscribedToday ? 'main-btn-done' : (reminderEnabled ? 'main-btn-success' : ''))}}"
    bindtap="requestSubscribe"
  >{{!reminderEnabled ? '开启每日提醒' : (remindTimePending ? '更新并续订提醒' : (subscribedToday ? '今日提醒已确认 ✓' : '续订今日提醒'))}}</button>
  <text wx:if="{{remindTimePending}}" class="btn-hint">提醒时间已改为 {{remindTime}}，点击上方按钮保存</text>

  <!-- 更多设置入口 -->
  <view class="settings-entry" bindtap="goSettings">
    <text class="settings-entry-text">更多设置</text>
    <text class="settings-entry-arrow">›</text>
  </view>

</view>
