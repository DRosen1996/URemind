page {
  min-height: 100vh;
  background: #F3F4F6;
}

.page {
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ─── 骨架屏 ─── */
.page-skeleton {
  display: flex;
  flex-direction: column;
}

.skeleton-card {
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 20rpx;
  background: #fff;
}

.skeleton-config {
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.skeleton-shimmer {
  background: linear-gradient(
    90deg,
    #E5E7EB 0%,
    #F3F4F6 50%,
    #E5E7EB 100%
  );
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.2s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.skeleton-line {
  border-radius: 8rpx;
  background: #E5E7EB;
}

.skeleton-line-sm {
  width: 120rpx;
  height: 22rpx;
  margin-bottom: 16rpx;
}

.skeleton-line-lg {
  width: 280rpx;
  height: 52rpx;
  margin-bottom: 12rpx;
}

.skeleton-line-md {
  width: 200rpx;
  height: 26rpx;
  margin-bottom: 28rpx;
}

.skeleton-line-xs {
  width: 140rpx;
  height: 22rpx;
  margin-top: 20rpx;
}

.skeleton-dots-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.skeleton-dots-row {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.skeleton-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton-config-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.skeleton-line-config {
  width: 160rpx;
  height: 28rpx;
}

.skeleton-line-value {
  width: 120rpx;
  height: 28rpx;
}

.skeleton-divider {
  height: 1rpx;
  background: #F3F4F6;
}

.skeleton-btn {
  height: 88rpx;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

/* ─── 内容入场 ─── */
.page-content-enter .status-card-block {
  animation: block-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.page-content-enter .card-enter {
  animation: block-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) 80ms both;
}

.page-content-enter .main-btn-enter {
  animation: block-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) 160ms both;
}

.page-content-enter .settings-entry-block {
  animation: block-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
}

@keyframes block-enter {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ─── 状态卡片 ─── */
.status-card {
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.card-pill {
  background: linear-gradient(135deg, #F5F0FF 0%, #EDE9FE 100%);
}

.card-break {
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
}

.card-pending {
  background: #fff;
}

.status-eyebrow {
  font-size: 22rpx;
  color: #9CA3AF;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.status-text {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.card-pill .status-text { color: #7C3AED; }
.card-break .status-text { color: #059669; }
.card-pending .status-text { color: #6B7280; }

.status-desc {
  font-size: 26rpx;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
}

.card-pill .status-desc { color: #8B5CF6; }
.card-break .status-desc { color: #10B981; }
.card-pending .status-desc { color: #9CA3AF; }

/* ─── 进度点阵 ─── */
.dots-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dots-row {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  transition: background 0.25s ease, transform 0.2s ease;
}

.dot-enter {
  animation: dot-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes dot-pop {
  from {
    opacity: 0;
    transform: scale(0.3);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.dot-done-pill    { background: #A78BFA; }
.dot-done-break   { background: #34D399; }
.dot-today-pill   { background: #7C3AED; transform: scale(1.25); box-shadow: 0 0 0 5rpx rgba(124,58,237,0.22); }
.dot-today-break  { background: #059669; transform: scale(1.25); box-shadow: 0 0 0 5rpx rgba(5,150,105,0.22); }
.dot-future-pill  { background: #DDD6FE; }
.dot-future-break { background: #A7F3D0; }
.dot-inactive     { background: #E5E7EB; }

.dot-today-pulse.dot-today-pill {
  animation: today-pulse-pill 2s ease-in-out infinite;
}

.dot-today-pulse.dot-today-break {
  animation: today-pulse-break 2s ease-in-out infinite;
}

.dot-enter.dot-today-pill {
  animation: dot-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both, today-pulse-pill 2s ease-in-out 0.35s infinite;
}

.dot-enter.dot-today-break {
  animation: dot-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both, today-pulse-break 2s ease-in-out 0.35s infinite;
}

@keyframes today-pulse-pill {
  0%, 100% {
    transform: scale(1.25);
    box-shadow: 0 0 0 5rpx rgba(124,58,237,0.22);
  }
  50% {
    transform: scale(1.35);
    box-shadow: 0 0 0 8rpx rgba(124,58,237,0.12);
  }
}

@keyframes today-pulse-break {
  0%, 100% {
    transform: scale(1.25);
    box-shadow: 0 0 0 5rpx rgba(5,150,105,0.22);
  }
  50% {
    transform: scale(1.35);
    box-shadow: 0 0 0 8rpx rgba(5,150,105,0.12);
  }
}

.progress-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 20rpx;
}

/* ─── 配置卡片 ─── */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.config-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.config-row-active {
  transform: scale(0.98);
  opacity: 0.92;
}

.config-label {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.config-value-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.config-value {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  transition: color 0.2s ease;
}

.arrow {
  font-size: 40rpx;
  color: #D1D5DB;
  line-height: 1;
  margin-top: -4rpx;
}

.divider {
  height: 1rpx;
  background: #F3F4F6;
}

/* ─── 主按钮 ─── */
.main-btn {
  margin-top: 8rpx;
  border-radius: 16rpx;
  background: #111827;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 26rpx 32rpx;
  line-height: 1.4;
  border: none;
  transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.15s ease;
}

.main-btn-active {
  transform: scale(0.98);
}

.main-btn-success {
  background: #10B981 !important;
  color: #fff !important;
  opacity: 1 !important;
}

.main-btn-pending {
  background: #F59E0B !important;
  color: #fff !important;
  opacity: 1 !important;
}

.main-btn-done {
  background: transparent !important;
  color: #10B981 !important;
  border: 2rpx solid #10B981 !important;
  opacity: 1 !important;
}

.config-value-pending {
  color: #F59E0B;
}

.btn-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 0;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.25s ease, opacity 0.25s ease, margin-top 0.25s ease;
}

.btn-hint-visible {
  max-height: 80rpx;
  opacity: 1;
  margin-top: 12rpx;
}

/* ─── 更多设置入口 ─── */
.settings-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 28rpx;
  padding: 16rpx;
  transition: transform 0.2s ease;
}

.settings-entry-active {
  transform: translateX(4rpx);
}

.settings-entry-text {
  font-size: 26rpx;
  color: #6B7280;
}

.settings-entry-arrow {
  font-size: 36rpx;
  color: #D1D5DB;
  line-height: 1;
  margin-top: -2rpx;
  transition: transform 0.2s ease;
}

.settings-entry-active .settings-entry-arrow {
  transform: translateX(4rpx);
}
