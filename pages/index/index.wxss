page {
  min-height: 100vh;
  background: #f5f6f8;
}

.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.status-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  color: #888;
  font-size: 24rpx;
}

.status {
  font-size: 42rpx;
  font-weight: 700;
}

.status.pill {
  color: #111;
}

.status.break {
  color: #3f7cff;
}

.status.pending {
  color: #888;
}

.desc {
  font-size: 24rpx;
  color: #666;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.field-label {
  color: #333;
}

.picker-value {
  color: #111;
  font-weight: 500;
}

.main-btn {
  margin-top: 8rpx;
  border-radius: 12rpx;
  background: #111;
  color: #fff;
}

.text-btn {
  margin-top: 12rpx;
  border: none;
  background: transparent;
  color: #666;
  font-size: 26rpx;
}

.hint {
  display: block;
  margin-top: 8rpx;
  color: #888;
  font-size: 24rpx;
  text-align: center;
}
