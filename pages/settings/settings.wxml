<view class="page">
  <view class="card">
    <view class="title">提醒开关（订阅消息）</view>
    <switch checked="{{reminderEnabled}}" bindchange="onStatusChange" />
    <text class="hint">提醒状态：{{reminderEnabled ? '已开启' : '已关闭'}}</text>
    <text class="hint {{subscriptionAccepted ? '' : 'warn'}}">
      订阅授权：{{subscriptionAccepted ? '已授权' : '未授权（请回首页点击“开启订阅提醒”）'}}
    </text>
  </view>

  <button class="danger-btn" bindtap="onResetCycle">重置周期开始日为今天</button>
</view>
