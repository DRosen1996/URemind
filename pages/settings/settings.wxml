<view class="page">

  <!-- 提醒开关卡片 -->
  <view class="card">
    <view class="setting-row">
      <view class="setting-row-left">
        <text class="setting-label">每日提醒</text>
        <text class="setting-sublabel">通过微信订阅消息推送</text>
      </view>
      <switch checked="{{reminderEnabled}}" bindchange="onStatusChange" color="#10B981" />
    </view>

    <view class="divider"></view>

    <view class="setting-row">
      <text class="setting-label">提醒状态</text>
      <view class="badge {{reminderEnabled ? 'badge-green' : 'badge-gray'}}">
        <text>{{reminderEnabled ? '已开启' : '已关闭'}}</text>
      </view>
    </view>

    <view class="divider"></view>

    <view class="setting-row">
      <text class="setting-label">订阅授权</text>
      <view class="badge {{subscriptionAccepted ? 'badge-green' : 'badge-orange'}}">
        <text>{{subscriptionAccepted ? '已授权' : '未授权'}}</text>
      </view>
    </view>
  </view>

  <text class="warn-hint" wx:if="{{!subscriptionAccepted}}">
    未授权时请回首页点击「开启每日提醒」
  </text>

  <!-- 危险操作区 -->
  <view class="danger-section">
    <button class="danger-btn" bindtap="onResetCycle">重置周期开始日为今天</button>
    <text class="danger-hint">此操作将把周期重新从今天开始计算</text>
  </view>

</view>
