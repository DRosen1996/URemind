.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.hint {
  font-size: 24rpx;
  color: #666;
}

.danger-btn {
  margin-top: 24rpx;
  background: #111;
  color: #fff;
  border-radius: 12rpx;
}
